    "-I", "/opt/homebrew/opt/curl/include" -- Need to check where it gets otherwise
  ]

  let srcJob ← inputFile src false
  let oJob   ← buildO oFile srcJob cflags
  buildStaticLib (pkg.staticLibDir / name) #[oJob]

