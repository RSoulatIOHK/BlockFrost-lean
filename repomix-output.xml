    IO.println ""

    exampleLatestBlock
    IO.println ""

    exampleAccountInfo config.stakeAddress
    IO.println ""

    exampleAddressUtxos config.address
    IO.println ""

    exampleAssetInfo config.asset
    IO.println ""

    exampleTransactionInfo config.txHash
